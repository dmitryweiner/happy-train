{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmitryweiner.github.io/happy-train/level.schema.json",
  "title": "Happy Train level (format v2)",
  "description": "Структура уровня. Стыковку рельсов и расстановку вагонов проверяет `yarn level validate`: схема этого не умеет.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grid",
    "trains",
    "station"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "grid": {
      "description": "grid[y][x], от 3 до 20 строк по 3–30 клеток (все строки одной длины; обычно 10×15). Клетка — соединения её сторон N/E/S/W: \"\" пусто, \"EW\"/\"NS\" прямая, \"SW\"/\"ES\"/\"NW\"/\"NE\" поворот, \"EW+SW\" стрелка (две пары с общей стороной, одна из них прямая), \"EW+NS\" пересечение.",
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 30,
        "items": {
          "$ref": "#/$defs/cell"
        }
      }
    },
    "switches": {
      "description": "Начальное положение стрелок. Стрелки, которых здесь нет, стоят \"straight\".",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "initial"
        ],
        "properties": {
          "at": {
            "$ref": "#/$defs/point"
          },
          "initial": {
            "enum": [
              "straight",
              "diverging"
            ]
          }
        }
      }
    },
    "semaphores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "initial"
        ],
        "properties": {
          "at": {
            "$ref": "#/$defs/point"
          },
          "initial": {
            "enum": [
              "open",
              "closed"
            ]
          }
        }
      }
    },
    "trains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "heading"
        ],
        "properties": {
          "at": {
            "$ref": "#/$defs/point",
            "description": "Клетка локомотива."
          },
          "heading": {
            "enum": [
              "N",
              "E",
              "S",
              "W"
            ],
            "description": "Куда едет поезд: сторона, через которую локомотив выйдет из своей клетки."
          },
          "wagons": {
            "description": "Вагоны от локомотива к хвосту. Встают сами, по одной клетке за локомотивом по пути назад.",
            "type": "array",
            "items": {
              "enum": [
                "wagon1",
                "wagon2"
              ]
            }
          }
        }
      }
    },
    "station": {
      "$ref": "#/$defs/point"
    }
  },
  "$defs": {
    "point": {
      "description": "[x, y]: x — столбец слева направо, y — строка сверху вниз, от 0.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 29
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "cell": {
      "type": "string",
      "pattern": "^$|^(NE|NS|NW|ES|EW|SW)(\\+(NE|NS|NW|ES|EW|SW))?$"
    }
  }
}
