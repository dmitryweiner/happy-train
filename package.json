{
  "name": "train-game",
  "version": "1.0.0",
  "description": "A simple train game with canvas",
  "main": "src/main.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests --exclude tests/golden/**",
    "test:golden": "vitest run tests/golden",
    "test:golden:update": "GOLDEN_ENGINE=legacy UPDATE_GOLDEN=1 vitest run tests/golden/golden.test.ts",
    "test:visual": "vitest run visual-tests",
    "test:visual:update": "rm -rf visual-tests/fixtures && UPDATE_VISUAL=1 vitest run visual-tests",
    "solve:legacy": "node tests/golden/legacy-solve.js"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "canvas": "^3.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
